rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);

      match /profile/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /wallets/{walletId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.balance is number
          && request.resource.data.type in ['cash', 'bank', 'ewallet', 'credit'];
        allow delete: if isOwner(userId);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.type in ['income', 'expense'];
        allow delete: if isOwner(userId);
      }

      match /transactions/{transId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense', 'transfer', 'lend', 'borrow']
          && request.resource.data.categoryId is string
          && request.resource.data.walletId is string;
        allow delete: if isOwner(userId);
      }

      match /budgets/{budgetId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.limitAmount is number
          && request.resource.data.limitAmount > 0
          && request.resource.data.month >= 1
          && request.resource.data.month <= 12
          && request.resource.data.year is int;
        allow delete: if isOwner(userId);
      }

      match /savings/{savingId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.targetAmount is number
          && request.resource.data.targetAmount > 0
          && request.resource.data.currentAmount is number
          && request.resource.data.currentAmount >= 0;
        allow delete: if isOwner(userId);
      }

      match /debts/{debtId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.totalAmount is number
          && request.resource.data.totalAmount > 0
          && request.resource.data.paidAmount is number
          && request.resource.data.paidAmount >= 0
          && request.resource.data.monthlyPayment is number
          && request.resource.data.interestRate is number
          && request.resource.data.lenderName is string;
        allow delete: if isOwner(userId);
      }

      match /installments/{planId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.totalAmount is number
          && request.resource.data.totalAmount > 0
          && request.resource.data.paidAmount is number
          && request.resource.data.monthlyPayment is number
          && request.resource.data.totalPeriods is int;
        allow delete: if isOwner(userId);
      }

      match /feedbacks/{feedbackId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.userDisplayName is string
          && request.resource.data.userEmail is string
          && request.resource.data.comment is string
          && request.resource.data.comment.size() >= 5
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
      }
    }

    match /{path=**}/transactions/{transId} {
      allow read: if isAdmin();
    }

    match /{path=**}/feedbacks/{feedbackId} {
      allow read: if isAdmin();
    }
  }
}
